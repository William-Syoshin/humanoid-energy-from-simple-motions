#VRML_SIM R2025a utf8
# Zero-gravity, airborne joint diagnostic ONLY; never use for Standing training.
EXTERNPROTO "../protos/Khr3hv17.proto"

WorldInfo {
  gravity 0
  basicTimeStep 8
  coordinateSystem "ENU"
  randomSeed 0
}
Viewpoint {
  orientation 0.18647977681302036 0.039175512455475306 -0.9816774277040382 2.8586313035918356
  position 1.1 0.42 0.7
}
Background {
  skyColor [ 0.85 0.9 0.95 ]
}
DirectionalLight {
  direction -1 -1 -2
}
Solid {
  translation 0 0 -0.025
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.65 0.68 0.7 roughness 1 metalness 0 }
      geometry Box { size 4 4 0.05 }
    }
  ]
  name "floor"
  boundingObject Box { size 4 4 0.05 }
}
DEF KHR Khr3hv17 {
  translation 0 0 0.6
  controller "khr_controller"
  supervisor TRUE
  synchronization TRUE
  selfCollision FALSE
  bodySlot [
    InertialUnit { name "imu" }
    Gyro { name "gyro" }
    Accelerometer { name "accelerometer" }
  ]
}
